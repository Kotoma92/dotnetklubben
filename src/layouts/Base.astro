---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title = 'Hjem - Dotnetklubben',
  description = 'Velkommen til Dotnetklubbens nettsider. Vi står blant annet bak DotnetLAN i Ulefosshallen. Her finner du siste nytt og annen arrangementsinfo.',
  ogTitle = 'Dotnetklubben arrangør av DotnetLAN',
  ogDescription = 'Velkommen til dotnetklubben sine nye nettsider! Her finner du alt du trenger som deltager samlet på ett sted.',
  ogImage = 'https://dotnetklubben.org/images/hero-bg.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://dotnetklubben.org');

const schemaJson = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://dotnetklubben.org/',
      url: 'https://dotnetklubben.org/',
      name: title,
      isPartOf: { '@id': 'https://dotnetklubben.org/#website' },
      about: { '@id': 'https://dotnetklubben.org/#organization' },
      primaryImageOfPage: { '@id': 'https://dotnetklubben.org/#primaryimage' },
      image: { '@id': 'https://dotnetklubben.org/#primaryimage' },
      thumbnailUrl: 'https://dotnetklubben.org/images/dotnetlan-logo-white-259x300.png',
      description,
      inLanguage: 'nb-NO',
    },
    {
      '@type': 'ImageObject',
      inLanguage: 'nb-NO',
      '@id': 'https://dotnetklubben.org/#primaryimage',
      url: 'https://dotnetklubben.org/images/dotnetlan-logo-white.png',
      contentUrl: 'https://dotnetklubben.org/images/dotnetlan-logo-white.png',
      width: 657,
      height: 760,
    },
    {
      '@type': 'WebSite',
      '@id': 'https://dotnetklubben.org/#website',
      url: 'https://dotnetklubben.org/',
      name: 'Dotnetklubben',
      description: 'Arrangør av Dotnet-LAN og andre events',
      publisher: { '@id': 'https://dotnetklubben.org/#organization' },
      inLanguage: 'nb-NO',
    },
    {
      '@type': 'Organization',
      '@id': 'https://dotnetklubben.org/#organization',
      name: 'Dotnetklubben',
      url: 'https://dotnetklubben.org/',
      logo: {
        '@type': 'ImageObject',
        inLanguage: 'nb-NO',
        '@id': 'https://dotnetklubben.org/#/schema/logo/image/',
        url: 'https://dotnetklubben.org/images/dotnetlan-logo.png',
        contentUrl: 'https://dotnetklubben.org/images/dotnetlan-logo.png',
        width: 657,
        height: 760,
        caption: 'Dotnetklubben',
      },
      image: { '@id': 'https://dotnetklubben.org/#/schema/logo/image/' },
      sameAs: ['https://www.facebook.com/dotnetklubben'],
    },
  ],
};
---

<!DOCTYPE html>
<html lang="nb-NO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/roboto-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/adventpro-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Dotnetklubben" />
    <meta property="article:publisher" content="https://www.facebook.com/dotnetklubben" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1366" />
    <meta property="og:image:type" content="image/jpeg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#0B0C10" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Hopp til hovedinnhold</a>
    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>&copy; {new Date().getFullYear()} Dotnetklubben &ndash; Arrangør av DotnetLAN og sosiale gaming-events i Nome.</p>
        <div class="footer-links">
          <a href="https://discord.gg/7fEfpeySEX" target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="https://www.facebook.com/dotnetklubben" target="_blank" rel="noopener noreferrer">Facebook</a>
          <a href="#kontakt">Kontakt oss</a>
        </div>
      </div>
    </footer>

    <button type="button" id="scroll-to-top" class="scroll-to-top" aria-label="Til toppen" hidden>
      <svg width="16" height="16" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
        <path d="M240.971 130.524l194.343 194.343c9.373 9.373 9.373 24.569 0 33.941l-22.667 22.667c-9.357 9.357-24.522 9.375-33.901.04L224 227.495 69.255 381.516c-9.379 9.335-24.544 9.317-33.901-.04l-22.667-22.667c-9.373-9.373-9.373-24.569 0-33.941L207.03 130.525c9.372-9.373 24.568-9.373 33.941-.001z" />
      </svg>
    </button>

    <script>
      const scrollBtn = document.getElementById('scroll-to-top');
      if (scrollBtn) {
        const toggleBtn = () => {
          if (window.scrollY > 300) {
            scrollBtn.hidden = false;
          } else {
            scrollBtn.hidden = true;
          }
        };
        window.addEventListener('scroll', toggleBtn, { passive: true });
        toggleBtn();
        scrollBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>

    <style>
      .site-footer {
        background-color: var(--color-bg-deep);
        border-top: 1px solid rgba(102, 252, 241, 0.15);
        padding: 28px 0;
        font-size: 14px;
        color: var(--color-text-muted);
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .footer-inner p {
        margin: 0;
      }
      .footer-links {
        display: flex;
        gap: 20px;
      }
      .footer-links a {
        color: var(--color-text-muted);
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--color-cyan);
      }
      .scroll-to-top {
        position: fixed;
        bottom: 15px;
        right: 15px;
        width: 50px;
        height: 50px;
        z-index: 9999;
        opacity: 0.75;
        background-color: #000000;
        color: #ffffff;
        border: 1px solid rgba(102, 252, 241, 0.3);
        border-radius: 5px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
      }
      .scroll-to-top[hidden] {
        display: none;
      }
      .scroll-to-top:hover {
        opacity: 1;
        border-color: var(--color-cyan);
        transform: translateY(-2px);
      }
      @media (max-width: 640px) {
        .footer-inner {
          flex-direction: column;
          text-align: center;
        }
      }
    </style>
  </body>
</html>
