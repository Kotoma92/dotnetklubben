---
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || '2a8440ec-bc50-4686-90eb-749b136af77c';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const actionUrl = '/api/kontakt';
---

<section id="kontakt" class="contact-section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="contact-header">
      <span class="contact-badge">Ta kontakt</span>
      <h2 id="contact-heading" class="contact-heading">Kontakt styret</h2>
      <p class="contact-sub">
        Har du spørsmål, innspill eller en idé til et arrangement i Nome? Send oss en melding under!
      </p>
    </div>

    <div class="contact-card">
      <form
        id="contact-form"
        class="contact-form"
        action={actionUrl}
        method="POST"
        novalidate
        data-web3forms-key={web3FormsKey}
      >
        <input type="hidden" name="from_name" value="Dotnetklubben Kontaktskjema" />

        <!-- Honeypot field against spam bots -->
        <div class="honeypot-wrap" aria-hidden="true">
          <label for="botcheck">Ikke fyll ut dette feltet</label>
          <input type="checkbox" name="botcheck" id="botcheck" tabindex="-1" autocomplete="off" />
          <input type="text" name="input_5" id="input_5" value="" tabindex="-1" autocomplete="off" />
        </div>

        <div id="form-feedback" class="form-feedback" role="alert" aria-live="polite" hidden></div>

        <div class="form-grid">
          <div class="form-row">
            <label for="contact-name" class="form-label">
              Navn <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              placeholder="Ditt navn"
              class="form-input"
              required
              aria-required="true"
              autocomplete="name"
            />
            <span class="field-error" id="error-name" hidden>Dette feltet er påkrevd.</span>
          </div>

          <div class="form-row">
            <label for="contact-email" class="form-label">
              E-postadresse <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              placeholder="din@epost.no"
              class="form-input"
              required
              aria-required="true"
              autocomplete="email"
            />
            <span class="field-error" id="error-email" hidden>Vennligst oppgi en gyldig e-postadresse.</span>
          </div>
        </div>

        <div class="form-row">
          <label for="contact-subject" class="form-label">
            Emne <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="contact-subject"
            name="subject"
            placeholder="Hva gjelder henvendelsen?"
            class="form-input"
            required
            aria-required="true"
          />
          <span class="field-error" id="error-subject" hidden>Dette feltet er påkrevd.</span>
        </div>

        <div class="form-row">
          <label for="contact-message" class="form-label">
            Din melding <span class="form-required" aria-hidden="true">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            placeholder="Skriv meldingen din her (maks 180 tegn)..."
            class="form-textarea"
            rows="5"
            maxlength="180"
            required
            aria-required="true"
            aria-describedby="message-counter"
          ></textarea>
          <div class="form-meta">
            <span class="field-error" id="error-message" hidden>Dette feltet er påkrevd (maks 180 tegn).</span>
            <span id="message-counter" class="char-counter">0 / 180</span>
          </div>
        </div>

        {
          turnstileSiteKey && (
            <div class="form-row">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
              <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
            </div>
          )
        }

        <div class="form-row form-row--submit">
          <button type="submit" id="contact-submit" class="form-submit">
            Send melding
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const nameInput = document.getElementById('contact-name') as HTMLInputElement;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement;
    const subjectInput = document.getElementById('contact-subject') as HTMLInputElement;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;
    const counterEl = document.getElementById('message-counter') as HTMLElement;
    const feedbackEl = document.getElementById('form-feedback') as HTMLElement;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const honeypotText = document.getElementById('input_5') as HTMLInputElement;
    const honeypotCheck = document.getElementById('botcheck') as HTMLInputElement;

    const MAX_LEN = 180;

    function updateCounter() {
      const len = messageInput.value.length;
      counterEl.textContent = `${len} / ${MAX_LEN}`;
      counterEl.classList.toggle('is-limit', len >= MAX_LEN);
    }

    messageInput.addEventListener('input', updateCounter);
    updateCounter();

    function showError(input: HTMLElement, errorId: string, show: boolean, customMsg?: string) {
      const errEl = document.getElementById(errorId);
      input.classList.toggle('has-error', show);
      if (errEl) {
        if (customMsg) errEl.textContent = customMsg;
        errEl.hidden = !show;
      }
    }

    function validate(): boolean {
      let valid = true;

      const nameVal = nameInput.value.trim();
      if (!nameVal) {
        showError(nameInput, 'error-name', true);
        valid = false;
      } else {
        showError(nameInput, 'error-name', false);
      }

      const emailVal = emailInput.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailVal || !emailRegex.test(emailVal)) {
        showError(
          emailInput,
          'error-email',
          true,
          !emailVal ? 'Dette feltet er påkrevd.' : 'Vennligst oppgi en gyldig e-postadresse.'
        );
        valid = false;
      } else {
        showError(emailInput, 'error-email', false);
      }

      const subjectVal = subjectInput.value.trim();
      if (!subjectVal) {
        showError(subjectInput, 'error-subject', true);
        valid = false;
      } else {
        showError(subjectInput, 'error-subject', false);
      }

      const messageVal = messageInput.value.trim();
      if (!messageVal) {
        showError(messageInput, 'error-message', true, 'Dette feltet er påkrevd.');
        valid = false;
      } else if (messageVal.length > MAX_LEN) {
        showError(messageInput, 'error-message', true, `Meldingen kan være maks ${MAX_LEN} tegn.`);
        valid = false;
      } else {
        showError(messageInput, 'error-message', false);
      }

      return valid;
    }

    [nameInput, emailInput, subjectInput, messageInput].forEach((el) => {
      el.addEventListener('blur', () => validate());
      el.addEventListener('input', () => {
        if (el.classList.contains('has-error')) validate();
      });
    });

    async function submitToWeb3Forms(formData: FormData, accessKey: string) {
      const fallbackData = new FormData();
      formData.forEach((value, key) => fallbackData.append(key, value));
      fallbackData.set('access_key', accessKey);

      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: fallbackData,
        headers: { Accept: 'application/json' },
      });
      const data = await res.json().catch(() => ({}));
      return { ok: res.ok && data.success !== false, data };
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      feedbackEl.hidden = true;
      feedbackEl.className = 'form-feedback';

      // Honeypot check
      if (honeypotText.value !== '' || honeypotCheck.checked) {
        return;
      }

      if (!validate()) {
        feedbackEl.textContent = 'Vennligst rett opp feilene i skjemaet før innsending.';
        feedbackEl.classList.add('is-error');
        feedbackEl.hidden = false;
        return;
      }

      submitBtn.disabled = true;
      const origText = submitBtn.textContent;
      submitBtn.textContent = 'Sender...';

      try {
        const formData = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        let data = await res.json().catch(() => ({}));
        let succeeded = res.ok && data.success !== false;

        // Automatic fallback to Web3Forms if Cloudflare Pages Function isn't configured with RESEND_API_KEY yet or running on static dev server
        const fallbackKey = form.dataset.web3formsKey;
        if (!succeeded && (res.status === 404 || res.status === 500 || res.status === 502) && fallbackKey) {
          const fallbackResult = await submitToWeb3Forms(formData, fallbackKey);
          succeeded = fallbackResult.ok;
          data = fallbackResult.data;
        }

        if (succeeded) {
          feedbackEl.textContent =
            data.message ||
            'Takk for din henvendelse! Vi har mottatt meldingen din og tar kontakt så snart vi kan.';
          feedbackEl.classList.add('is-success');
          feedbackEl.hidden = false;
          form.reset();
          updateCounter();
        } else {
          throw new Error(data.message || 'Kunne ikke sende skjemaet.');
        }
      } catch (err) {
        feedbackEl.textContent =
          err instanceof Error && err.message
            ? err.message
            : 'Det oppstod en feil ved innsending av skjemaet. Vennligst prøv igjen senere eller ta kontakt via Discord/Facebook.';
        feedbackEl.classList.add('is-error');
        feedbackEl.hidden = false;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = origText;
      }
    });
  }
</script>

<style>
  .contact-section {
    background: linear-gradient(180deg, var(--color-bg-dark) 0%, var(--color-bg-deep) 100%);
    padding: 72px 20px 88px 20px;
  }

  .contact-header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 32px auto;
  }

  .contact-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-cyan);
    background: rgba(102, 252, 241, 0.1);
    border: 1px solid rgba(102, 252, 241, 0.25);
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .contact-heading {
    color: var(--color-text-light);
    font-family: var(--font-sans);
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 700;
    margin: 0 0 10px 0;
  }

  .contact-sub {
    color: var(--color-text-muted);
    font-size: 16px;
    margin: 0;
  }

  .contact-card {
    max-width: 720px;
    margin: 0 auto;
    background: rgba(11, 12, 16, 0.65);
    border: 1px solid rgba(102, 252, 241, 0.22);
    border-radius: 14px;
    padding: 36px 38px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.35);
  }

  .honeypot-wrap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-feedback {
    padding: 14px 18px;
    margin-bottom: 24px;
    font-size: 15px;
    border-radius: 8px;
  }

  .form-feedback[hidden] {
    display: none;
  }

  .form-feedback.is-error {
    background-color: rgba(224, 69, 98, 0.14);
    color: #ff9ebb;
    border: 1px solid rgba(224, 69, 98, 0.45);
  }

  .form-feedback.is-success {
    background-color: rgba(102, 252, 241, 0.12);
    color: var(--color-cyan);
    border: 1px solid rgba(102, 252, 241, 0.4);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .form-row {
    margin-bottom: 20px;
  }

  .form-row--submit {
    margin-bottom: 0;
    margin-top: 8px;
  }

  .form-label {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-light);
    margin-bottom: 8px;
  }

  .form-required {
    color: var(--color-cyan);
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 12px 14px;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--color-text-light);
    background-color: rgba(31, 40, 51, 0.65);
    border: 1px solid rgba(197, 198, 199, 0.25);
    border-radius: 8px;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: rgba(197, 198, 199, 0.45);
  }

  .form-input:hover,
  .form-textarea:hover {
    border-color: rgba(102, 252, 241, 0.45);
  }

  .form-input:focus,
  .form-textarea:focus {
    background-color: rgba(31, 40, 51, 0.9);
    border-color: var(--color-cyan);
    box-shadow: 0 0 0 3px rgba(102, 252, 241, 0.12);
    outline: none;
  }

  .form-input.has-error,
  .form-textarea.has-error {
    border-color: var(--color-error);
  }

  .form-textarea {
    min-height: 130px;
    resize: vertical;
  }

  .form-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
    gap: 12px;
  }

  .char-counter {
    margin-left: auto;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .char-counter.is-limit {
    color: var(--color-cyan);
    font-weight: 600;
  }

  .field-error {
    display: block;
    font-size: 13px;
    color: #ff8fa3;
    margin-top: 6px;
  }

  .field-error[hidden] {
    display: none;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 32px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-bg-deep);
    background-color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .form-submit:hover:not(:disabled) {
    background-color: #8afff7;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(102, 252, 241, 0.28);
  }

  .form-submit:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  @media (max-width: 640px) {
    .contact-section {
      padding: 56px 16px 72px 16px;
    }

    .contact-card {
      padding: 24px 20px;
    }

    .form-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .form-submit {
      width: 100%;
    }
  }
</style>
